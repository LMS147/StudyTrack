<resources>
    <!--
      DARK palette (values-night). Same names as values/colors.xml — the
      DayNight theme picks this file automatically when the app (or the whole
      phone) is in dark mode. Deep navy surfaces with the same purple accent,
      brightened priority colours so pills stay legible on dark backgrounds.
    -->

    <!-- Brand -->
    <color name="brand_primary">#6D59D3</color>
    <color name="brand_primary_dark">#5A49C4</color>
    <color name="brand_on_primary">#FFFFFF</color>
    <color name="brand_container">#292448</color>
    <color name="brand_on_container">#D2CCFF</color>
    <color name="brand_secondary">#A89DFF</color>

    <!-- Surfaces & text -->
    <color name="background">#0B0F1A</color>
    <color name="surface_card">#171D2C</color>
    <color name="surface_nav">#101523</color>
    <color name="surface_sunken">#202739</color>
    <color name="surface_bubble_ai">#1A2131</color>
    <color name="text_primary">#F3F4FA</color>
    <color name="text_secondary">#B4BCD0</color>
    <color name="white">#FFFFFF</color>
    <color name="divider">#30384A</color>

    <!-- Priority (bright foregrounds, deep tinted containers) -->
    <color name="priority_high">#FF6B81</color>
    <color name="priority_medium">#FFB020</color>
    <color name="priority_low">#4ADE80</color>
    <color name="priority_high_container">#3A1D2B</color>
    <color name="priority_medium_container">#3A2E15</color>
    <color name="priority_low_container">#14301F</color>

    <!-- Status -->
    <color name="success">#4ADE80</color>
    <color name="success_container">#14301F</color>
    <color name="overdue_red">#FF6B81</color>

    <!-- Level/XP banner gradient (Home + Progress) -->
    <color name="level_gradient_start">#30285F</color>
    <color name="level_gradient_end">#1D2A42</color>

    <!-- AI accents -->
    <color name="ai_gradient_start">#5947C9</color>
    <color name="ai_gradient_end">#363D7D</color>

    <!-- Launcher -->
    <color name="ic_launcher_background">#6C5CE7</color>
    <!-- Text and track drawn on the purple level banner (same in both themes) -->
    <color name="on_level_gradient">#CCFFFFFF</color>
    <color name="on_level_gradient_track">#33FFFFFF</color>
</resources>
