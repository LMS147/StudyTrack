<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="8dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_chevron_left" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_back" app:tint="@color/text_primary" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/flashcards_review_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/text_primary" />
    </LinearLayout>
    <TextView android:id="@+id/reviewCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/text_secondary" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/reviewCard" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="16dp" app:strokeWidth="1dp" app:strokeColor="@color/divider">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp" android:padding="24dp" android:orientation="vertical">
                    <TextView android:id="@+id/reviewSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="@color/brand_secondary" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/flashcards_question" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/questionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/answerLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/flashcards_answer" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/answerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/doneText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="@string/flashcards_done" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/text_primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/revealButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/flashcards_reveal" />
            <TextView android:id="@+id/ratingLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/flashcards_how_well" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/text_primary" />
            <LinearLayout android:id="@+id/ratingButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/againButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flashcards_again" />
                <com.google.android.material.button.MaterialButton android:id="@+id/hardButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flashcards_hard" />
                <com.google.android.material.button.MaterialButton android:id="@+id/easyButton" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flashcards_easy" />
            </LinearLayout>
            <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/overdue_red" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>